  color: #f8fafc;
  padding: 16px;
  border-radius: 16px 0 0 16px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-right: none;
  box-shadow: -10px 20px 40px rgba(0, 0, 0, 0.45);
}

.music-top-row {
