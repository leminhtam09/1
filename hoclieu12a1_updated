/* Bảng Đúng / Sai (Phần II) Trong Phòng Thi */
.tf-exam-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin-top: 12px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
  background: #ffffff;
}

.tf-exam-table th {
  background: #f8fafc;
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 700;
  color: #475569;
  border-bottom: 1px solid #e2e8f0;
  text-align: center;
}

.tf-exam-table th:first-child {
  text-align: left;
}

.tf-exam-table td {
  padding: 12px 14px;
  border-bottom: 1px solid #f1f5f9;
  font-size: 13px;
  vertical-align: middle;
}

.tf-exam-table tr:last-child td {
  border-bottom: none;
}

.tf-exam-table td.tf-col-radio {
  text-align: center;
  width: 90px;
  background: #fcfcfd;
}

.tf-radio-label {
  display: inline-flex;
