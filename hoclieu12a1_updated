  50% { transform: scale(1.06); }
}

.palette-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  margin-top: 12px;
}

.palette-btn {
  padding: 9px 0;
  text-align: center;
  border-radius: 8px;
  background-color: #e2e8f0;
  color: #475569;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
}

.palette-btn.answered {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
}

