}

.vinyl-center {
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #fff;
}

@keyframes spinDisk {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.music-track-info {
  overflow: hidden;
  flex: 1;
}

.music-track-title {
  font-weight: 700;
  font-size: 13.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
