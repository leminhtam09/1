  transition: all 0.15s;
}

.btn-tf-toggle.active-true {
  background: #10b981;
  border-color: #059669;
  color: #ffffff;
  box-shadow: 0 2px 5px rgba(16, 185, 129, 0.3);
}

.btn-tf-toggle.active-false {
  background: #ef4444;
  border-color: #dc2626;
  color: #ffffff;
